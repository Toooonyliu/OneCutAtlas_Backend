# Configure secrets in Render's environment settings, never in frontend code.
OPENAI_API_KEY=
# Vision model for avatar colors and place recognition; verify access in your API project.
OPENAI_MODEL=gpt-6-luna
# Image model for photo arenas (POST /api/scenes). Defaults to gpt-image-2; set empty to disable painting.
OPENAI_IMAGE_MODEL=gpt-image-2
# low | medium | high. Medium is the default; low is far cheaper for a 480x270 target.
SCENE_QUALITY=medium
# Painting switch and demo caps. These reset on restart; the prepaid provider balance is the hard limit.
SCENE_ENABLED=true
SCENE_PER_HOUR=3
SCENE_MAX_PER_DAY=40
SCENE_MAX_CONCURRENT=2
RECOGNIZE_PER_MINUTE=5
PORT=4174
HOST=0.0.0.0
ALLOWED_ORIGINS=https://toooonyliu.github.io,http://localhost:4173,http://127.0.0.1:4173
AI_PER_MINUTE=5
AI_MAX_CALLS=50
AI_MAX_CONCURRENT=2
# Require a portfolio Origin for production photo requests; not authentication.
AI_REQUIRE_ORIGIN=false
