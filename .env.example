# Configure secrets in Render's environment settings, never in frontend code.
OPENAI_API_KEY=
# Vision model for avatar colors and place recognition; verify access in your API project.
OPENAI_MODEL=gpt-6-luna
# Image model for photo arenas (POST /api/scenes). Defaults to gpt-image-2; set empty to disable painting.
OPENAI_IMAGE_MODEL=gpt-image-2
# low | medium | high for the OpenAI painter.
SCENE_QUALITY=medium
# Free painter first: a ModelScope API-Inference token (account bound to a real-name-verified Alibaba Cloud account).
# auto = ModelScope when MODELSCOPE_API_KEY is set, otherwise OpenAI. SCENE_FALLBACK=openai repaints with OpenAI when the free quota is used up.
MODELSCOPE_API_KEY=
MODELSCOPE_IMAGE_MODEL=Qwen/Qwen-Image-Edit-2509
SCENE_PROVIDER=auto
SCENE_FALLBACK=openai
# Public URLs of the game's own stages used as style references for the free painter.
STYLE_REFERENCE_URLS=
# Painting switch and demo caps. These reset on restart; the prepaid provider balance is the hard limit.
SCENE_ENABLED=true
SCENE_PER_HOUR=3
SCENE_MAX_PER_DAY=40
SCENE_MAX_CONCURRENT=2
RECOGNIZE_PER_MINUTE=5
# Image detail sent to the vision model (high reads signage; low is cheaper) and its reasoning effort.
RECOGNIZE_DETAIL=high
RECOGNIZE_REASONING=none
PORT=4174
HOST=0.0.0.0
ALLOWED_ORIGINS=https://toooonyliu.github.io,http://localhost:4173,http://127.0.0.1:4173
AI_PER_MINUTE=5
AI_MAX_CALLS=50
AI_MAX_CONCURRENT=2
# Require a portfolio Origin for production photo requests; not authentication.
AI_REQUIRE_ORIGIN=false
