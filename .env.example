# Configure secrets in Render's environment settings, never in frontend code.
OPENAI_API_KEY=
# Recommended low-cost image-input model; verify access in your API project.
OPENAI_MODEL=gpt-6-luna
PORT=4174
HOST=0.0.0.0
ALLOWED_ORIGINS=https://toooonyliu.github.io,http://localhost:4173,http://127.0.0.1:4173
AI_PER_MINUTE=5
AI_MAX_CALLS=50
AI_MAX_CONCURRENT=2
# Require a portfolio Origin for production photo requests; not authentication.
AI_REQUIRE_ORIGIN=false
